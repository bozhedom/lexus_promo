{
  "name": "lexus-promo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' next dev --webpack",
    "build": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' next build --webpack",
    "start": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "node tests/e2e/funnel-smoke.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:3000 --no-autoupdate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' payload migrate",
    "admin:reset": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' payload run scripts/reset-admin.ts",
    "seed:car-photos": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000' payload run scripts/seed-car-photos.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "next": "16.2.10",
    "payload": "^3.86.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
