# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.

# ─── Обязательное ──────────────────────────────────────────────────────────

# База данных. Локально поднимается командой: docker compose up -d
DATABASE_URL=postgres://promo:promo@localhost:5432/promo

# Секрет Payload. Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# ─── Определение авто по госномеру ─────────────────────────────────────────

# Внешний API, ходим через прокси /api/car-info. Если пусто — определение
# выключено и воронка сразу просит заполнить марку и модель вручную.
CAR_API_URL=http://dev.api2.club.mg/cars
CAR_API_KEY=

# ─── Аналитика ─────────────────────────────────────────────────────────────

# Яндекс.Метрика.
NEXT_PUBLIC_YM_ID=
# Google Analytics (опционально)
NEXT_PUBLIC_GA_ID=

# ─── Внешние ссылки итогового экрана ───────────────────────────────────────
# Если пусто, кнопка ведёт на «#»

NEXT_PUBLIC_LINK_CALC=
NEXT_PUBLIC_LINK_BOOKING=
NEXT_PUBLIC_LINK_BOOK=
NEXT_PUBLIC_LINK_MESSENGER=
NEXT_PUBLIC_LINK_MAP=
NEXT_PUBLIC_LINK_SITE=

# ─── Прочее ────────────────────────────────────────────────────────────────

# Публичный адрес сайта, подставляется в метаданные страниц.
# Он же используется как база для адресов вебхуков модуля /invite-test,
# поэтому на боевом сервере это должен быть настоящий https-домен.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Стартовое раскрытие штор руками. false — первый экран появляется сразу.
NEXT_PUBLIC_INTRO_CURTAIN_ENABLED=false

# ─── Тестовый модуль /invite-test ──────────────────────────────────────────
# Отдельная демо-страница с отправкой сертификатов в мессенджеры.
# Полная инструкция: src/invite-test/README.md. Модуль удаляется целиком,
# вместе с этими переменными.

# @username менеджера в Telegram, к нему ведёт кнопка. Обязательно.
INVITE_TEST_TG_MANAGER=

# Токен бота от @BotFather. Бот подключается к аккаунту менеджера через
# Telegram Business и отправляет сертификаты от его имени. В переписке
# бота не видно. Без токена кнопка работает, но сертификаты шлёт менеджер сам.
INVITE_TEST_TG_BOT_TOKEN=
# Произвольная строка, Telegram присылает её в заголовке вебхука
INVITE_TEST_TG_WEBHOOK_SECRET=
# Идентификатор подключения. Обычно приходит сам, когда менеджер подключает
# бота; заполняется вручную, чтобы пережить перезапуск сервера.
INVITE_TEST_TG_BUSINESS_ID=

# Официальный бот MAX: диплинк передаёт код, бот автоматически шлёт сертификаты.
INVITE_TEST_MAX_BOT_USERNAME=
INVITE_TEST_MAX_BOT_TOKEN=
INVITE_TEST_MAX_WEBHOOK_SECRET=
INVITE_TEST_MAX_API_URL=
# Личный username менеджера. Бот покажет кнопку перехода в его чат.
INVITE_TEST_MAX_MANAGER=

# WhatsApp Business: номер без плюса и QR-инстанс GREEN-API (без Meta).
INVITE_TEST_WA_PHONE=
INVITE_TEST_WA_GREEN_INSTANCE_ID=
INVITE_TEST_WA_GREEN_API_TOKEN=
# Уникальный apiUrl из кабинета, например https://7105.api.greenapi.com
INVITE_TEST_WA_GREEN_API_URL=
# Случайная строка; /setup сам передаст её GREEN-API для защиты webhook.
INVITE_TEST_WA_GREEN_WEBHOOK_TOKEN=

# Ключ для разового вызова /api/invite-test/setup (прописывает вебхук)
INVITE_TEST_SETUP_KEY=
